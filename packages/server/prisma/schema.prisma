// ---------------------------------------------------------------------------
// MediaVault – Prisma Schema
//
// SQLite is the default database. The schema is designed to be portable
// to PostgreSQL with minimal changes.
// ---------------------------------------------------------------------------

generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Project – top-level isolation boundary
// ---------------------------------------------------------------------------

model Project {
    id          String   @id @default(uuid())
    name        String   @unique
    description String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    apiKeys ApiKey[]
    files   FileMetadata[]
    folders Folder[]

    @@index([name])
}

// ---------------------------------------------------------------------------
// API Key – per-project authentication
// ---------------------------------------------------------------------------

model ApiKey {
    id         String    @id @default(uuid())
    projectId  String
    key        String    @unique
    label      String    @default("default")
    createdAt  DateTime  @default(now())
    lastUsedAt DateTime?

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([projectId])
    @@index([key])
}

// ---------------------------------------------------------------------------
// Folder – hierarchical organisation
// ---------------------------------------------------------------------------

model Folder {
    id        String   @id @default(uuid())
    projectId String
    parentId  String?
    name      String
    path      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
    parent   Folder?        @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
    children Folder[]       @relation("FolderTree")
    files    FileMetadata[]

    @@unique([projectId, path])
    @@index([projectId])
    @@index([parentId])
}

// ---------------------------------------------------------------------------
// FileMetadata – everything we know about a stored file
// ---------------------------------------------------------------------------

model FileMetadata {
    id               String   @id @default(uuid())
    projectId        String
    folderId         String?
    filename         String
    originalFilename String
    extension        String
    mimeType         String
    size             Int
    hash             String
    visibility       String   @default("private")
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
    folder  Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

    @@unique([projectId, filename])
    @@index([projectId])
    @@index([folderId])
    @@index([visibility])
    @@index([hash])
}

// ---------------------------------------------------------------------------
// Settings – application configuration & admin credentials
// ---------------------------------------------------------------------------

model Settings {
    key   String @id
    value String
}

// ---------------------------------------------------------------------------
// UploadRule – per-category and per-extension upload limits
// ---------------------------------------------------------------------------

model UploadRule {
    id        String   @id @default(uuid())
    category  String
    extension String?
    enabled   Boolean  @default(true)
    maxSize   Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([category])
    @@index([category, extension])
}

// ---------------------------------------------------------------------------
// Session – dashboard admin sessions
// ---------------------------------------------------------------------------

model Session {
    id           String   @id @default(uuid())
    adminId      String
    createdAt    DateTime @default(now())
    lastActivity DateTime @default(now())
    expiresAt    DateTime

    @@index([adminId])
    @@index([expiresAt])
}
