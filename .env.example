DATABASE_URL="file:./data/mediavault.db"
MEDIAVAULT_PORT=3000
MEDIAVAULT_HOST=0.0.0.0
MEDIAVAULT_STORAGE_DRIVER=local
MEDIAVAULT_STORAGE_LOCAL_PATH=./uploads
MEDIAVAULT_MAX_FILE_SIZE=104857600
MEDIAVAULT_AUTH_ENABLED=true
MEDIAVAULT_API_KEY_HEADER=x-api-key
MEDIAVAULT_SIGNED_URL_SECRET=change-me-in-production
MEDIAVAULT_LOG_LEVEL=info
MEDIAVAULT_LOG_PRETTY=true
